PORT=8000
NODE_ENV=development

# Neon Database URL (or any PostgreSQL connection string)
DATABASE_URL=

# Local PostgreSQL Fallback
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=invoicer_db

# Redis (Upstash, AWS ElastiCache, or Local Memurai/Redis)
# For cloud Redis (e.g. Upstash): rediss://default:password@xyz.upstash.io:6379
REDIS_URL=
# Or Local Fallback:
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Google Gemini API Key & Model
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Frontend URLs
CLIENT_URL=http://localhost:3000
